{
  "manifest_version": 3,
  "name": "CrabTab - 现代毛玻璃极简起始页",
  "version": "1.1.0",
  "description": "极简精致、现代毛玻璃美学的智能新标签页与主页扩展",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "favicon",
    "storage",
    "history",
    "geolocation",
    "bookmarks"
  ],
  "host_permissions": [
    "https://weatherapi.market.xiaomi.com/*",
    "https://api.open-meteo.com/*",
    "https://*.bing.com/*",
    "https://suggestion.baidu.com/*",
    "https://suggestqueries.google.com/*",
    "https://duckduckgo.com/*",
    "https://raw.githubusercontent.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://v1.hitokoto.cn/*",
    "https://wp.upx8.com/*",
    "http://wallpaper.apc.360.cn/*",
    "https://speed.cloudflare.com/*",
    "https://registry.npmmirror.com/*"
  ],
  "action": {
    "default_title": "打开新标签页"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
